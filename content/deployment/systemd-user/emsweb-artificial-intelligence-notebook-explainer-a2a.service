[Unit]
Description=Machine Learning persistent notebook signed explainer A2A provider
After=network.target witness-journal-rdf-projection-service.service emsweb-notebooklm-inference-a2a.service emsweb-notebooklm-inference-artifacts.service emsweb-artificial-intelligence-notebook-artifacts.service
Requires=witness-journal-rdf-projection-service.service emsweb-notebooklm-inference-a2a.service emsweb-notebooklm-inference-artifacts.service emsweb-artificial-intelligence-notebook-artifacts.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node src/serve-a2a.mjs
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=ARTIFICIAL_INTELLIGENCE_NOTEBOOK_DATA_ROOT=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise/data
Environment=ARTIFICIAL_INTELLIGENCE_NOTEBOOK_EXCHANGE_ROOT=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise/data/artifact-exchange
Environment=ARTIFICIAL_INTELLIGENCE_NOTEBOOK_ARTIFACT_BASE_URL=http://127.0.0.1:18449
Environment=ARTIFICIAL_INTELLIGENCE_NOTEBOOK_SETTLEMENT_ACCOUNT=eip155:31337:0x418f8af108510becd04d29dda4c0362cd3a442be
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise/data
ReadOnlyPaths=/home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise/data/credentials /home/emsenn/info/lib/emsenn/services/561-group/services/rsc-quiescent/services/emsweb/services/artificial-intelligence-persistent-notebook-enterprise/data/evm/keystores
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
